{
  "name": "ds_raw_transactions_csv",
  "properties": {
    "linkedServiceName": {
      "referenceName": "ls_adls_mi",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "p_folderPath": { "type": "String" },
      "p_fileName": { "type": "String" }
    },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "raw",
        "folderPath": "@{dataset().p_folderPath}",
        "fileName": "@{dataset().p_fileName}"
      },
      "columnDelimiter": ",",
      "firstRowAsHeader": true
    }
  }
}
